# Single API URL (Security + Housekeeping + Auth). No trailing slash.
# REQUIRED for Vercel/production web builds (HTTPS in production).
#
# Examples:
#   Local:      http://localhost:5115
#   Render:     https://godrejair.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:5115
# Optional: only if running a separate Housekeeping API locally (port 5116)
# EXPO_PUBLIC_HOUSEKEEPING_API_URL=http://localhost:5116

# Optional: Google Cloud Vision for water meter OCR (client-side; restrict key by HTTP referrer in GCP)
# EXPO_PUBLIC_GOOGLE_VISION_API_KEY=your_api_key_here

# ── Backend env vars (NOT EXPO_PUBLIC_; set on Render or in the API's appsettings) ──
# Any OpenAI-protocol-compatible provider works (Groq, OpenAI, Together, Ollama).
# Currently using Groq (multimodal Llama 4 Scout for water-photo vision + chat).
# LLM_API_KEY=gsk_...                                          # Groq key (or sk-... for OpenAI)
# LLM_BASE_URL=https://api.groq.com/openai/v1                  # https://api.openai.com/v1 for OpenAI
# LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct          # gpt-4o-mini for OpenAI
# Legacy OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL are still honoured as a fallback.

#   Resident: demo / demo123
#   Admin:    testadmin / testadmin123
