# API base URL (no trailing slash). REQUIRED for Vercel/production web builds.
# Must be HTTPS in production (mixed-content blocks http:// from https://godrej-air.vercel.app).
# Set the same variable in Vercel → Settings → Environment Variables, then redeploy.
#
# Examples:
#   Local:      http://localhost:5115
#   Production: https://your-securityops-api.azurewebsites.net
EXPO_PUBLIC_API_URL=http://localhost:5115

# Test logins (seeded when SecurityOps API starts — restart API after pull):
#   Resident: demo / demo123
#   Admin:    testadmin / testadmin123
